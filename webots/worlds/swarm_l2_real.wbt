#VRML_SIM R2025a utf8
# UTM swarm, Level 2, realistic look: Bitcraze's official Crazyflie model (same dynamics as
# swarm_l2.wbt's equivalent, motors spin up at maxTorque 30), real sky, grass, and obstacles
# drawn as buildings/towers of exactly the layout's size (visual only, no bounding objects:
# LiDAR and crash checks stay analytic). Assets are fetched by Webots from cyberbotics/webots R2025a.

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Grass.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/bitcraze/crazyflie/protos/Crazyflie.proto"
IMPORTABLE EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/buildings/protos/SimpleBuilding.proto"

WorldInfo {
  info [ "UTM swarm Level 2 (realistic look): official Crazyflie, velocity PID, gravity" ]
  basicTimeStep 4
  coordinateSystem "ENU"
}
DEF VIEW Viewpoint {
  orientation -0.3 0.3 0.9 1.7
  position 0 -12 8
}
TexturedBackground {
  texture "noon_cloudy_countryside"
}
TexturedBackgroundLight {
  texture "noon_cloudy_countryside"
}
Floor {
  size 120 120
  tileSize 4 4
  appearance Grass {
  }
}
DEF OBSTACLES Group {
}
DEF DRONES Group {
  children [
    DEF DRONE_0 Crazyflie {
      translation 0 0 1
      name "swarm_supervisor"
      controller "<extern>"
      supervisor TRUE
    }
  ]
}
